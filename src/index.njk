<!DOCTYPE html>
<html lang="en" class="landing-html">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ site.name }}</title>
    <meta name="description" content="{{ site.description }}">
    <link rel="icon" href="{{ site.baseUrl }}static/images/logo.ico">
    <link rel="stylesheet" href="{{ site.baseUrl }}static/css/style.css">
</head>

<body class="landing">
    <a href="{{ site.baseUrl }}home" class="landing-link" aria-label="Enter {{ site.name }}"></a>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const isMobile = window.matchMedia('(max-width: 768px)').matches;
        const images = isMobile ? [
            "{{ site.baseUrl }}static/images/1 - mobile.jpg",
            "{{ site.baseUrl }}static/images/2 - mobile.jpg",
            "{{ site.baseUrl }}static/images/3 - mobile.jpg",
            "{{ site.baseUrl }}static/images/4 - mobile.jpg",
        ] : [
            "{{ site.baseUrl }}static/images/1.jpg",
            "{{ site.baseUrl }}static/images/2.jpg",
            "{{ site.baseUrl }}static/images/3.jpg",
            "{{ site.baseUrl }}static/images/4.jpg",
            "{{ site.baseUrl }}static/images/5.jpg",
            "{{ site.baseUrl }}static/images/6.jpg",
        ];

        const randomIndex = Math.floor(Math.random() * images.length);
        document.body.style.backgroundImage = `url('${images[randomIndex]}')`;
    });
    </script>
</body>
</html>
