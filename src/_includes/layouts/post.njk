---
layout: layouts/base.njk
bodyClass: body-article
stylesheet: blog-style.css
showBanner: false
ogType: article
---

<article class="post-container">
  <div class="post-content">
    <header class="post-header">
      <h1 class="post-heading">{{ title }}</h1>
      <div class="post-meta">
        <p class="post-date">{{ datePosted | formatDate }}</p>
        <p class="post-author">by {{ author }}</p>
      </div>
    </header>
    {{ content | safe }}
  </div>
</article>