<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title %}{{ title }} - {% endif %}{{ site.name }}</title>
    <link rel="icon" href="{{ site.baseUrl }}static/images/logo.ico">
    <link rel="stylesheet" href="{{ site.baseUrl }}static/css/navbar.css">
    <link rel="stylesheet" href="{{ site.baseUrl }}static/css/{{ stylesheet or 'style.css' }}">
</head>
<body class="{{ bodyClass or '' }}">
    <main class="main-content">
        {% if showNavigation !== false %}
        <div class="overlay-text">
            <a href="{{ site.baseUrl }}home" class="nav-item nav-name">
                <img src="{{ site.baseUrl }}static/images/logo.png" alt="Your Name Logo" class="name-logo">
            </a>
            <div class="nav-links">
                <a href="{{ site.baseUrl }}about/" class="nav-item">about</a>
                <a href="{{ site.baseUrl }}blogs/" class="nav-item">read</a>
                <a href="{{ site.baseUrl }}contact/" class="nav-item">contact</a>
                <button class="nav-item subscribe-nav-btn" id="subscribe-open">subscribe</button>
            </div>
        </div>
        {% endif %}
        <div class="scrolling-banner">
            <div class="scrolling-track">
                <div class="scrolling-item" aria-hidden="true">｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆</div>
                <div class="scrolling-item" aria-hidden="true">｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆.⋆｡⋆˚｡⋆｡˚☽˚｡⋆.+*:ꔫ:*﹤｡･:*:･ﾟ★,｡･:*:･ﾟ☆✧༺♥༻∞｡･:*:･ﾟ★,｡･:*:･ﾟ☆</div>
            </div>
        </div>
        {{ content | safe }}
    </main>


    <div class="subscribe-overlay" id="subscribe-overlay" role="dialog" aria-modal="true" aria-label="Subscribe">
        <div class="subscribe-modal">
            <button class="subscribe-close" id="subscribe-close" aria-label="Close">&times;</button>
            <p class="subscribe-heading">stay in the loop</p>
            <form action="https://github.us19.list-manage.com/subscribe/post-json?u=186537096480d22ea1f8ec6d6&amp;id=6c0325d046" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form">
                <div class="subscribe-name-row">
                    <input type="text" name="FNAME" id="mce-FNAME" placeholder="first name">
                    <input type="text" name="LNAME" id="mce-LNAME" placeholder="last name">
                </div>
                <input type="email" name="EMAIL" id="mce-EMAIL" placeholder="your email" required>
                <div aria-hidden="true" style="position:absolute;left:-5000px">
                    <input type="text" name="b_186537096480d22ea1f8ec6d6_6c0325d046" tabindex="-1" value="">
                </div>
                <button type="submit" name="subscribe" id="mc-submit">subscribe</button>
                <p class="subscribe-msg" id="subscribe-msg"></p>
            </form>
        </div>
    </div>

    {% if not inlineScript %}
    <script src="{{ site.baseUrl }}static/js/{{ jsFile or 'script.js' }}"></script>
    {% endif %}
</body>
</html>